# Option 1: full connection URL (encode special characters in password, e.g. @ -> %40)
DATABASE_URL=postgresql://postgres:dev%40123@localhost:5432/erp_demo

# Option 2: individual settings (used when DATABASE_URL is not set)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=erp_demo
# DB_USER=postgres
# DB_PASSWORD=password

# Azure Blob sync (optional)
# AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net

# Snowflake loader (optional) — scripts/load_snowflake.py
# SF_ACCOUNT=your_account_locator
# SF_USER=your_username
# SF_PASSWORD=your_password
# SF_WAREHOUSE=COMPUTE_WH
# SF_DATABASE=FLEXIPACK
# SF_SCHEMA=PUBLIC
